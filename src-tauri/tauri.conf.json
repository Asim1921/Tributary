{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tributary",
  "version": "0.1.0",
  "identifier": "app.tributary.desktop",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:bundle",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tributary",
        "width": 1120,
        "height": 700,
        "minWidth": 780,
        "minHeight": 460,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "A fast, resumable download manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/tributary-host.exe": "tributary-host.exe",
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/background.js": "extension/background.js",
      "../extension/content.js": "extension/content.js",
      "../extension/rules.js": "extension/rules.js",
      "../extension/icons/32.png": "extension/icons/32.png",
      "../extension/icons/128.png": "extension/icons/128.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
