{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tributary",
  "version": "0.3.0",
  "identifier": "app.tributary.desktop",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:bundle",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tributary",
        "width": 1120,
        "height": 700,
        "minWidth": 780,
        "minHeight": 460,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "A fast, resumable download manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../target/release/tributary-host.exe": "tributary-host.exe",
      "../extension/manifest.json": "extension/manifest.json",
      "../extension/background.js": "extension/background.js",
      "../extension/content.js": "extension/content.js",
      "../extension/popup.html": "extension/popup.html",
      "../extension/popup.js": "extension/popup.js",
      "../extension/rules.js": "extension/rules.js",
      "../extension/_locales/ar/messages.json": "extension/_locales/ar/messages.json",
      "../extension/_locales/en/messages.json": "extension/_locales/en/messages.json",
      "../extension/_locales/es/messages.json": "extension/_locales/es/messages.json",
      "../extension/_locales/hi/messages.json": "extension/_locales/hi/messages.json",
      "../extension/_locales/ur/messages.json": "extension/_locales/ur/messages.json",
      "../extension/icons/32.png": "extension/icons/32.png",
      "../extension/icons/128.png": "extension/icons/128.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis-hooks.nsh"
      },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign.ps1 %1"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4MDI1NkI2OTc4QjBBNzEKUldSeENvdVh0bFlDK0t5MnlmVGJYZ0pyQ3NEZ3NZWjlnTU5ZSS9VUVdKUFk3TGtxOXAyU3pyZ3MK",
      "endpoints": [
        "https://tributary-olive.vercel.app/api/updates/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
