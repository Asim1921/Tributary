# Copy to .env and adjust. .env is git-ignored.

# Host port that nginx publishes (the only published port).
SITE_PORT=8080

# Salt for the privacy-preserving download counter (hash of IP + user agent + day).
# Use a long random value in any real deployment, e.g.  openssl rand -hex 32
COUNT_SALT=change-me-to-a-long-random-string

MONGO_DB=tributary

# Seconds the API keeps release and stats responses in Redis.
CACHE_TTL_RELEASES=60
CACHE_TTL_STATS=30

LOG_LEVEL=info
