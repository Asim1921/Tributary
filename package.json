{
  "name": "tributary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "prepare:bundle": "npm run ui:build && cargo build --release -p host",
    "tauri": "tauri",
    "check": "svelte-check --tsconfig ui/tsconfig.json",
    "test": "vitest run --config ui/vite.config.ts",
    "e2e": "node e2e/app.mjs",
    "e2e:browser": "node e2e/browser.mjs chrome",
    "e2e:edge": "node e2e/browser.mjs edge"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "^1.65.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
